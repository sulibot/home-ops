# ==============================================================================
# VRF CROSS-CONNECT (VETH PAIR)
# Created by Proxmox SDN, Configured by Ansible
# ==============================================================================
{% set node_id = (inventory_hostname | regex_replace('^pve0?', '') | int) %}

# Global side (default VRF)
auto xvrf_evpnz1
iface xvrf_evpnz1 inet6 static
    address fd00:255:254:{{ node_id }}::1/127
    # Create the veth pair if Proxmox hasn't already
    pre-up ip link show xvrf_evpnz1 >/dev/null 2>&1 || ip link add xvrf_evpnz1 type veth peer name xvrfp_evpnz1
    # Ensure the link is administratively UP before addressing
    pre-up ip link set xvrf_evpnz1 up || true
    pre-up ip link set xvrfp_evpnz1 up || true
    # Enable IPv6 forwarding specifically on this interface for BGP peering
    post-up sleep 1 && sysctl -w net.ipv6.conf.xvrf_evpnz1.forwarding=1 || true
    # Optimization: Disable Router Advertisements to prevent neighbors from getting confused
    post-up sysctl -w net.ipv6.conf.xvrf_evpnz1.accept_ra=0 || true
    # ENG-322/ENG-324/ENG-359: SNAT'd tenant traffic's reply path crosses
    # from the default VRF (where vmbr0.10's un-SNAT happens) back into
    # vrf_evpnz1 via this xvrf cross-connect - a plain veth pair, not
    # enslaved NAT awareness. This VRF crossing hits a real Linux kernel
    # double-POSTROUTING/conntrack bug for NAT'd flows crossing a VRF
    # boundary via a veth: the packet gets POSTROUTING-processed once via
    # the VRF's own vrf_l3_out() and again via the real egress device's
    # ip_output(), which can create two divergent conntrack entries for one
    # connection (the second SNAT pass can even randomize the source port -
    # confirmed live via ip6tables NAT66 for ENG-359, byte-level corrupted
    # TCP source ports on data-bearing segments after the handshake).
    #
    # A single flat `CT --zone 5` (same zone for both original and reply
    # direction) on both veth ends was tried first and is NOT sufficient -
    # it conflates the two directions instead of tracking them separately,
    # which a documented netfilter zone-collision bug describes as causing
    # new conntrack entries to be dropped at confirmation time. This
    # interface (xvrf_evpnz1) only ever carries ORIGINAL-direction traffic
    # for a tenant-initiated flow (the pre-SNAT request, arriving here from
    # xvrfp_evpnz1 on its way to vmbr0.10) - so it gets --zone-orig only.
    # The reply direction is tagged separately at xvrfp_evpnz1 (see that
    # stanza below). See docs/tickets/eng-322-vrf-evpnz1-ipv4-snat.md and
    # Linear ENG-322/324/359.
    post-up iptables -w -t raw -C PREROUTING -i xvrf_evpnz1 -j CT --zone-orig 5 2>/dev/null || iptables -w -t raw -I PREROUTING -i xvrf_evpnz1 -j CT --zone-orig 5 || true
    post-down iptables -w -t raw -D PREROUTING -i xvrf_evpnz1 -j CT --zone-orig 5 || true
    # ENG-359: `iptables` and `ip6tables` are entirely separate rulesets -
    # the rule above (added under ENG-322 for an IPv4 TLS/DNS bug) never
    # applied to IPv6 traffic at all. This tenant fabric is IPv6-primary
    # (NAT66 for tenant ULA->GUA egress), so the IPv6 equivalent is what
    # actually matters for ENG-359's conntrack corruption - add it
    # explicitly rather than assuming the v4 rule covered both.
    post-up ip6tables -w -t raw -C PREROUTING -i xvrf_evpnz1 -j CT --zone-orig 5 2>/dev/null || ip6tables -w -t raw -I PREROUTING -i xvrf_evpnz1 -j CT --zone-orig 5 || true
    post-down ip6tables -w -t raw -D PREROUTING -i xvrf_evpnz1 -j CT --zone-orig 5 || true

# VRF side (vrf_evpnz1)
auto xvrfp_evpnz1
iface xvrfp_evpnz1 inet6 static
    address fd00:255:254:{{ node_id }}::0/127
    vrf vrf_evpnz1
    # Ensure the veth pair exists even if this stanza runs first
    pre-up ip link show xvrfp_evpnz1 >/dev/null 2>&1 || ip link add xvrf_evpnz1 type veth peer name xvrfp_evpnz1
    pre-up ip link set xvrfp_evpnz1 up || true
    post-up sleep 1 && sysctl -w net.ipv6.conf.xvrfp_evpnz1.forwarding=1 || true
    post-up sysctl -w net.ipv6.conf.xvrfp_evpnz1.accept_ra=0 || true
    # ENG-322/ENG-324/ENG-359: other end of the same crossing - see
    # xvrf_evpnz1 stanza above for the full explanation. This interface
    # only ever carries REPLY-direction traffic (post-un-NAT responses
    # arriving from vmbr0.10/the default VRF, heading back to the tenant
    # container) - so it gets --zone-reply only, matching the same zone id
    # used for --zone-orig on the other end, so the two directions of one
    # logical connection share a single coherent zone-5 view without
    # colliding on a flat, non-directional assignment.
    post-up iptables -w -t raw -C PREROUTING -i xvrfp_evpnz1 -j CT --zone-reply 5 2>/dev/null || iptables -w -t raw -I PREROUTING -i xvrfp_evpnz1 -j CT --zone-reply 5 || true
    post-down iptables -w -t raw -D PREROUTING -i xvrfp_evpnz1 -j CT --zone-reply 5 || true
    # ENG-359: IPv6 equivalent - see xvrf_evpnz1 stanza above for why this
    # is needed as its own rule, separate from the iptables (v4) one.
    post-up ip6tables -w -t raw -C PREROUTING -i xvrfp_evpnz1 -j CT --zone-reply 5 2>/dev/null || ip6tables -w -t raw -I PREROUTING -i xvrfp_evpnz1 -j CT --zone-reply 5 || true
    post-down ip6tables -w -t raw -D PREROUTING -i xvrfp_evpnz1 -j CT --zone-reply 5 || true
