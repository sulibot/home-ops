{# =====================================================================
  /etc/frr/frr.conf  (Jinja2 template)

  Goal:
    - VRF "{{ VRF_NAME }}" learns K8s pod/VIP routes from VMs (dynamic neighbors)
    - PVE exports selected VRF routes to GLOBAL (and later iBGP mesh / EDGE)

  FIXES IN THIS REV:
    1) Correct EDGE peer-group usage:
       - peer-groups must be named (EDGE4/EDGE6)
       - neighbors must be the actual IPs ({{ EDGE_V4 }} / {{ EDGE_V6 }})
       This aligns with the intended running-config form. :contentReference[oaicite:3]{index=3}

    2) Ensure VMs have an OUT policy:
       - RM_VMS_OUT_V6 exists and is applied outbound
       - avoids "Outbound updates discarded due to missing policy" when policy is enforced.
       :contentReference[oaicite:4]{index=4} :contentReference[oaicite:5]{index=5}
===================================================================== #}

{# -----------------------------
   Variable Mapping
----------------------------- #}
{% set node_id        = (inventory_hostname | regex_replace('^pve0?', '') | int) %}
{% set infra_ip4      = "10.255.0." ~ node_id %}
{% set infra_ip6      = "fd00:0:0:ffff::" ~ node_id %}
{% set pipe_global    = "fd00:255:254:" ~ node_id ~ "::1" %}
{% set pipe_vrf       = "fd00:255:254:" ~ node_id ~ "::0" %}
{% set vrf_router_id  = "10.255.255." ~ ((node_id - 1) * 4 + 2) %}
{% set ceph_pub_self  = "fc00:20::" ~ node_id %}

{# --- Site / fabric knobs --- #}
{% set LOCAL_AS       = local_as       | default("4200001000") %}
{% set EDGE_AS        = edge_as        | default("4200000000") %}
{% set EDGE_V4        = edge_v4        | default("10.255.0.254") %}
{% set EDGE_V6        = edge_v6        | default("fd00:0:0:ffff::fffe") %}

{# VRF name/table #}
{% set VRF_NAME       = vrf_name       | default("vrf_evpnz1") %}
{% set VRF_VXLAN_ID   = vrf_vxlan_id   | default(network_facts.sdn_vrf_vxlan) %}

{# Tenant prefix lists (adjust as needed) #}
{% set TENANT_V4_LIST = tenant_v4_list | default(["10.100.0.0/24","10.101.0.0/24","10.102.0.0/24","10.103.0.0/24"]) %}
{% set TENANT_V6_LIST = tenant_v6_list | default(["fd00:100::/48","fd00:101::/48","fd00:102::/48","fd00:103::/48"]) %}
{% set TENANT_LOOPBACK_V6_LIST = tenant_loopback_v6_list | default(["fd00:100:fe::/64","fd00:101:fe::/64","fd00:102:fe::/64","fd00:103:fe::/64"]) %}
{% set TENANT_GUA_V6_LIST = tenant_gua_v6_list | default(["2600:1700:ab1a:500e::/64","2600:1700:ab1a:500d::/64","2600:1700:ab1a:500c::/64","2600:1700:ab1a:500b::/64"]) %}

{# K8s route policy (cluster-specific) #}
{% set K8S_PODS_V6    = k8s_pods_v6    | default("fd00:101:224::/60") %}
{% set K8S_PODS_V4    = k8s_pods_v4    | default("10.101.224.0/20") %}
{% set K8S_VIPS_V6_LIST = k8s_vips_v6_list | default(["fd00:101:250::/112", "fd00:101:253::/112", "fd00:101:254::/112"]) %}
{% set K8S_LOOPBACKS_V6 = k8s_loopbacks_v6 | default("fd00:101:fe::/64") %}
{% set K8S_SERVICES_V4 = k8s_services_v4 | default("10.101.96.0/20") %}
{% set K8S_SERVICES_V6 = k8s_services_v6 | default("fd00:101:96::/108") %}

{# VMs listen ranges for dynamic neighbors (list-driven for scale) #}
{% set VMS_LISTEN_V6_LIST = vms_listen_v6_list | default([vms_listen_v6 | default("fd00:100::/56")]) %}
{% set VMS_LISTEN_V4_LIST = vms_listen_v4_list | default([vms_listen_v4 | default("10.100.0.0/16")]) %}

{# =====================================================================
   Global FRR plumbing
===================================================================== #}
frr version 10.5.1
frr defaults datacenter
hostname {{ inventory_hostname }}
log syslog informational
service integrated-vtysh-config
!
ip forwarding
ipv6 forwarding
!
bfd
 profile EDGE_BFD
  minimum-ttl 1
  transmit-interval 300
  receive-interval 300
  detect-multiplier 3
 !
!
{% if VRF_NAME %}
vrf {{ VRF_NAME }}
 vni {{ VRF_VXLAN_ID }}
exit-vrf
{% endif %}
!

{# =====================================================================
   Prefix-lists
===================================================================== #}

ip prefix-list PL_DEFAULT_V4 seq 5 permit 0.0.0.0/0
!
ipv6 prefix-list PL_DEFAULT_V6 seq 5 permit ::/0
!
ipv6 prefix-list PL_INFRA_V6 seq 5 permit fd00:0:0:ffff::/64 le 128
ipv6 prefix-list PL_SVCS_V6  seq 5 permit fc00:20::/48 le 128
!
{# PVE's own native EVPN Type-2 SVI/anycast-gateway per-node identity
   addresses (advertise-svi-ip, VNI 10101 etc - not something this
   template controls the origin of). Confirmed live 2026-07-25:
   fd00:101::fffd:2 (pve02's own SVI identity) was being leaked to
   RouterOS by ALL THREE nodes via the broad PL_TENANT_V6 match below
   (RM_VRF_TO_GLOBAL_V6/RM_EDGE_EXPORT_V6), since each node imports
   every other node's copy via Type-5 with no way to tell "mine" from
   "a peer's" at that point in the pipeline. RouterOS then picked
   whichever node it learned it from first (not necessarily the real
   owner), and traffic silently black-holed via the non-owning node.
   These addresses are PVE-internal fabric plumbing - no external
   system has a legitimate reason to reach them directly - so the
   correct fix is exclusion, not trying to arbitrate "true owner"
   per-address. Only verified/observed for fd00:101 so far; extend to
   fd00:100/102/103 with the same le 112 pattern if the same symptom
   ever surfaces there. #}
ipv6 prefix-list PL_PVE_INTERNAL_V6 seq 5 permit fd00:101::fffd:0/112 le 128
!

{# --- Tenants --- #}
{# Simple "all tenants" v4 (override if you want per-tenant granularity) #}
ip prefix-list PL_TENANT_V4 seq 10 permit 10.100.0.0/14 le 32
!
{% for p in TENANT_V6_LIST %}
ipv6 prefix-list PL_TENANT_V6 seq {{ 10 + loop.index0*10 }} permit {{ p }} le 128
{% endfor %}
{% for p in TENANT_LOOPBACK_V6_LIST %}
ipv6 prefix-list PL_TENANT_V6 seq {{ 100 + loop.index0*10 }} permit {{ p }} ge 128 le 128
{% endfor %}
!
{% for p in TENANT_GUA_V6_LIST %}
ipv6 prefix-list PL_TENANT_GUA_V6 seq {{ 10 + loop.index0*10 }} permit {{ p }} le 128
{% endfor %}
!

{# --- K8s --- #}
ipv6 prefix-list PL_K8S_PODS_V6 seq 5 permit {{ K8S_PODS_V6 }} ge 64 le 64
ip prefix-list PL_K8S_PODS_V4 seq 5 permit {{ K8S_PODS_V4 }} ge 24 le 24
{% for p in K8S_VIPS_V6_LIST %}
ipv6 prefix-list PL_K8S_VIPS_V6 seq {{ 5 + loop.index0*10 }} permit {{ p }} le 128
{% endfor %}
ipv6 prefix-list PL_K8S_LOOPBACKS_V6 seq 5 permit {{ K8S_LOOPBACKS_V6 }} le 128
ip prefix-list PL_K8S_SERVICES_V4 seq 5 permit {{ K8S_SERVICES_V4 }} le 32
ipv6 prefix-list PL_K8S_SERVICES_V6 seq 5 permit {{ K8S_SERVICES_V6 }} le 128
!
{# VM next-hop filter - only advertise VIPs when next-hop is VM-side (owner PVE).
   Scoped to BGP-capable tenants only (vm_nh_v6_list = bgp_dynamic_neighbors
   tenants); a tenant with no BGP speakers can't legitimately be a VM
   next-hop for anything. #}
{% set VM_NH_V6_LIST = vm_nh_v6_list | default(["fd00:101::/64"]) %}
{% set VMS_LOCAL_PREF_ANYCAST_V6 = vms_local_pref_anycast_v6 | default([]) %}
{% set VMS_ANYCAST_NS = namespace(local_next_hops=[]) %}
{% for item in VMS_LOCAL_PREF_ANYCAST_V6 %}
{% set local_next_hop = item.local_next_hops[inventory_hostname] | default('') %}
{% if local_next_hop %}
{% set VMS_ANYCAST_NS.local_next_hops = VMS_ANYCAST_NS.local_next_hops + [local_next_hop] %}
{% endif %}
{% endfor %}
{% for p in VM_NH_V6_LIST %}
ipv6 prefix-list PL_VM_NH_V6 seq {{ 10 + loop.index0*10 }} permit {{ p }} le 128
{% endfor %}
{% for item in VMS_LOCAL_PREF_ANYCAST_V6 %}
ipv6 prefix-list PL_VMS_LOCALPREF_ANYCAST_V6 seq {{ 10 + loop.index0*10 }} permit {{ item.prefix }}
{% endfor %}
{% for p in VMS_ANYCAST_NS.local_next_hops | unique %}
ipv6 prefix-list PL_VMS_LOCALPREF_NH_V6 seq {{ 10 + loop.index0*10 }} permit {{ p }}
{% endfor %}
!

{# =====================================================================
   BGP Community Lists (for scalable policy)
===================================================================== #}
!
bgp large-community-list standard CL_TENANT_ROUTES permit {{ LOCAL_AS }}:0:101
bgp large-community-list standard CL_K8S_INTERNAL permit {{ LOCAL_AS }}:0:100
bgp large-community-list standard CL_K8S_PUBLIC   permit {{ LOCAL_AS }}:0:200
bgp large-community-list standard CL_IBGP_LEARNED permit {{ LOCAL_AS }}:0:900
bgp large-community-list standard CL_K8S_PUBLIC_AND_IBGP permit {{ LOCAL_AS }}:0:200 {{ LOCAL_AS }}:0:900
!

{# =====================================================================
   Route-maps
===================================================================== #}

{# --- iBGP Inbound Policy (Tag routes learned via iBGP) --- #}
{% if VMS_LOCAL_PREF_ANYCAST_V6 | length > 0 %}
route-map RM_IBGP_IN permit 5
 match ipv6 address prefix-list PL_VMS_LOCALPREF_ANYCAST_V6
 set large-community {{ LOCAL_AS }}:0:900 additive
 set local-preference {{ vms_local_pref_anycast_v6_ibgp_preference | default(100) }}
exit
!
{% endif %}
route-map RM_IBGP_IN permit 10
 set large-community {{ LOCAL_AS }}:0:900 additive
exit
!
{# ENG-327: RouterOS advertises its own internal service host routes
   (10.255.0.0/24, includes the cluster's IPv4 DNS/NTP resolver at
   10.255.0.53) via BOTH this direct EDGE BGP session AND OSPF
   (redistribute=connected on RouterOS). No inbound filter existed for
   this peer, so we accepted the BGP copy too - and BGP's admin distance
   (20) always beats OSPF's (110), so nodes' DNS/NTP traffic to
   10.255.0.53 got routed via the general default-route/exit-node path
   instead of the correct direct-to-RouterOS OSPF path, causing
   persistent UDP timeouts (found live via a Talos node's own console
   logs - "time query error"/"error serving dns request", source
   10.101.0.21). This is a real, pre-existing bug independent of
   anything else tonight - RouterOS has always dual-advertised this
   range, it just happened to only visibly break once this specific
   BGP path became preferred. Deny it here so OSPF (the correct,
   intended source for this range) is the only path. #}
ip prefix-list PL_INTERNAL_SVCS_V4 seq 5 permit 10.255.0.0/24 le 32
!
route-map RM_EDGE_IN_V4 deny 5
 match ip address prefix-list PL_INTERNAL_SVCS_V4
exit
!
route-map RM_EDGE_IN_V4 permit 10
exit
!
{# ENG-327: IPv6 equivalent of the V4 fix above - fd00:0:0:ffff::53 (same
   DNS/NTP resolver, IPv6) had the identical BGP-vs-OSPF6 conflict. #}
ipv6 prefix-list PL_INTERNAL_SVCS_V6 seq 5 permit fd00:0:0:ffff::/64 le 128
!
route-map RM_EDGE_IN_V6 deny 5
 match ipv6 address prefix-list PL_INTERNAL_SVCS_V6
exit
!
route-map RM_EDGE_IN_V6 permit 10
exit
!
{# --- Edge export policy (what GLOBAL advertises to RouterOS EDGE) --- #}
route-map RM_EDGE_EXPORT_V4 deny 5
 match large-community CL_K8S_PUBLIC_AND_IBGP
exit
!
route-map RM_EDGE_EXPORT_V4 permit 10
 match ip address prefix-list PL_K8S_PODS_V4
 match large-community CL_K8S_INTERNAL
exit
!
route-map RM_EDGE_EXPORT_V4 permit 15
 match ip address prefix-list PL_TENANT_V4
exit
!
route-map RM_EDGE_EXPORT_V4 permit 20
 match large-community CL_K8S_PUBLIC
exit
!
route-map RM_EDGE_EXPORT_V6 deny 5
 match large-community CL_K8S_PUBLIC_AND_IBGP
exit
!
route-map RM_EDGE_EXPORT_V6 deny 6
 match ipv6 address prefix-list PL_PVE_INTERNAL_V6
exit
!
route-map RM_EDGE_EXPORT_V6 permit 10
 match ipv6 address prefix-list PL_K8S_PODS_V6
 match large-community CL_K8S_INTERNAL
exit
!
route-map RM_EDGE_EXPORT_V6 permit 12
 match ipv6 address prefix-list PL_TENANT_V6
exit
!
route-map RM_EDGE_EXPORT_V6 permit 15
 match ipv6 address prefix-list PL_TENANT_GUA_V6
exit
!
route-map RM_EDGE_EXPORT_V6 permit 20
 match large-community CL_K8S_PUBLIC
 match ipv6 next-hop prefix-list PL_VM_NH_V6
exit
!
{# ENG-328: applied to non-primary nodes' EDGE session in place of
   RM_EDGE_EXPORT_V4/V6 above. All 3 hosts independently advertised
   identical VM/tenant routes to RouterOS with no way for it to tell
   which was authoritative - it picked arbitrarily, and got it wrong for
   solwk01, silently breaking DNS/NTP. Only pve01 (the primary) exports
   now; other nodes' EDGE session stays up (still importing the default
   route in) but sends nothing out. #}
route-map RM_EDGE_EXPORT_NONE deny 5
exit
!

{# --- VRF<->GLOBAL leak policy --- #}
route-map RM_GLOBAL_TO_VRF_V4 deny 5
 match ip address prefix-list PL_K8S_SERVICES_V4
exit
!
{# ENG-322: this node's own default route, leaked in from the default VRF,
   must always beat a default route learned from a PEER exit node via
   EVPN Type-5 - otherwise BGP best-path has no reason to prefer local and
   picks arbitrarily, sending "local" exit traffic on a detour across the
   VXLAN fabric to whichever node happens to win (double encapsulation),
   and defeats exitnodes-local-routing entirely. Without this, the leaked
   route never reliably wins over a peer's advertisement, which is why a
   hand-rolled static kernel route (distance 0) was added as a workaround
   in interfaces.pve.j2 - that workaround is what's suspected of causing
   the VRF-crossing double-POSTROUTING/conntrack bug tracked in
   docs/tickets/eng-322-vrf-evpnz1-ipv4-snat.md. #}
route-map RM_GLOBAL_TO_VRF_V4 permit 10
 match ip address prefix-list PL_DEFAULT_V4
 set local-preference 500
exit
!
route-map RM_GLOBAL_TO_VRF_V6 deny 5
 match ipv6 address prefix-list PL_K8S_SERVICES_V6
exit
!
route-map RM_GLOBAL_TO_VRF_V6 permit 10
 match ipv6 address prefix-list PL_DEFAULT_V6
 set local-preference 500
exit
!
{# ENG-322 (actual fix) / ENG-324 (tracks this as its own tech debt - no
   upstream Proxmox/FRR bug exists for this gap, see that ticket before
   assuming it's been fixed elsewhere): the "import vrf default" leak
   above is NOT what
   each node's own default route actually travels through - it's
   self-originated into L2VPN EVPN via `default-originate` under the
   vrf_evpnz1 BGP process (native Proxmox SDN behavior, not overridable
   with a route-map on this FRR version). That self-originated route and
   a PEER's self-originated default (learned back via EVPN Type-5,
   nexthop across the VXLAN fabric) arrive at identical default
   local-preference (100), so BGP best-path picks between "my own local
   exit" and "tunnel to some other node's exit" arbitrarily - this is the
   real reason exitnodes-local-routing silently failed and traffic ended
   up double-encapsulated on some nodes. Fix: downgrade default routes
   RECEIVED FROM PEERS (both via the VTEP L2VPN EVPN session and the
   parallel IBGP session, which carries the same NLRIs and otherwise
   bypasses this entirely) so a node's own local default always wins by
   comparison. MAP_VTEP_IN itself is native-SDN-generated
   (permit 1, no match, no set) - these entries are appended after it in
   the merged frr.conf, so `no route-map MAP_VTEP_IN permit 1` here
   removes native's plain catch-all and these are shift in ahead of a new
   one. Live-tested and confirmed on pve03 before being committed here -
   see docs/tickets/eng-322-vrf-evpnz1-ipv4-snat.md and Linear ENG-324. #}
no route-map MAP_VTEP_IN permit 1
!
route-map MAP_VTEP_IN permit 5
 match ip address prefix-list PL_DEFAULT_V4
 set local-preference 50
exit
!
route-map MAP_VTEP_IN permit 6
 match ipv6 address prefix-list PL_DEFAULT_V6
 set local-preference 50
exit
!
route-map MAP_VTEP_IN permit 10
exit
!
{# This node's OWN Ceph public address must still leak in normally -
   it's the only source Type-5 has to advertise to the other two nodes
   (see the VRF's `address-family l2vpn evpn` block below). Denying the
   whole fc00:20::/48 (below) would also block this self-import and
   break Type-5 at the source - confirmed live 2026-07-25 during
   rollout: every node could only reach its own Ceph address until this
   permit was added ahead of the broader deny. #}
ipv6 prefix-list PL_SVCS_LOCAL_V6 seq 5 permit {{ ceph_pub_self }}/128
!
route-map RM_GLOBAL_TO_VRF_V6 permit 14
 match ipv6 address prefix-list PL_SVCS_LOCAL_V6
exit
!
{# The other two nodes' Ceph addresses (and this node's own, redundantly
   covered by permit 14 above) are reached via Type-5/L3VNI, not this
   Type-2 VRF leak. Denying it here (rather than leaving it as `permit`)
   matters: FRR assigns vrf-imported "Local" routes an artificial weight
   of 32768, which always wins BGP best-path selection over the correct
   iBGP/Type-5-learned path regardless of validity - and zebra does not
   fall back to the second-best path when the winner fails kernel
   install (the exact "Nexthop id does not exist" bug this was fixing).
   Leaving this as unconditional `permit` would silently reintroduce the
   2026-07-25 Ceph reachability outage even with Type-5 configured. #}
route-map RM_GLOBAL_TO_VRF_V6 deny 15
 match ipv6 address prefix-list PL_SVCS_V6
exit
!
route-map RM_GLOBAL_TO_VRF_V6 permit 30
 match ipv6 address prefix-list PL_K8S_PODS_V6
 match large-community CL_K8S_INTERNAL
exit
!
{# Tenant host routes (e.g. Talos control-plane VIPs) tagged Public (:200) by
   bird2's direct_routes export - these leak VRF->global->VRF fine on the
   originating node but were never re-imported into sibling nodes' VRFs.
   This closes that gap at the BGP control-plane level (the route now
   reaches every node's vrf_evpnz1 table), but is NOT a full fix on its
   own: on non-originating nodes the leaked route's next-hop only
   resolves via the EVPN L2/VXLAN fabric, and FRR's plain "import vrf"
   leak does not correctly recursive-resolve interface-based/link-local
   next-hops across VRF boundaries (a documented FRR limitation, not
   something fixable via route-map). Those nodes show the route as
   `Status: Failed` in `show ipv6 route vrf vrf_evpnz1` - present, valid,
   not FIB-installed. Real cross-node forwarding for this address still
   depends on EVPN Type-2 ARP/ND snooping succeeding, same as before this
   change. Harmless to keep (an uninstalled route doesn't break anything)
   but do not treat this as the durable fix for
   docs/tickets/pve-evpn-vip-arp-nd-suppression-gap.md (ENG-7) - see that
   ticket for what was actually ruled out/still open. #}
route-map RM_GLOBAL_TO_VRF_V6 permit 35
 match ipv6 address prefix-list PL_TENANT_V6
 match large-community CL_K8S_PUBLIC
exit
!
route-map RM_VRF_TO_GLOBAL_V4 permit 10
 match ip address prefix-list PL_TENANT_V4
exit
!
route-map RM_VRF_TO_GLOBAL_V4 permit 20
 match large-community CL_K8S_PUBLIC
exit
!
route-map RM_VRF_TO_GLOBAL_V4 permit 25
 match large-community CL_K8S_INTERNAL
exit
!
route-map RM_VRF_TO_GLOBAL_V4 deny 999
exit
!
route-map RM_VRF_TO_GLOBAL_V6 deny 5
 match ipv6 address prefix-list PL_PVE_INTERNAL_V6
exit
!
route-map RM_VRF_TO_GLOBAL_V6 permit 10
 match ipv6 address prefix-list PL_TENANT_V6
exit
!
route-map RM_VRF_TO_GLOBAL_V6 permit 12
 match large-community CL_TENANT_ROUTES
exit
!
route-map RM_VRF_TO_GLOBAL_V6 permit 15
 match ipv6 address prefix-list PL_TENANT_GUA_V6
exit
!
route-map RM_VRF_TO_GLOBAL_V6 permit 20
 match large-community CL_K8S_PUBLIC
exit
!
route-map RM_VRF_TO_GLOBAL_V6 permit 25
 match large-community CL_K8S_INTERNAL
exit
!
route-map RM_VRF_TO_GLOBAL_V6 deny 999
exit
!

{# --- VMS inbound policy (what we ACCEPT from the K8s VMs into VRF) --- #}
{# "Guard Rail" Logic: Accept anything in the Tenant Block if it has a valid Community tag #}
{# This allows the VM to declare "Public" vs "Internal" intent without PVE config changes. #}
{# Deny service CIDRs first to prevent them from leaking from VMs. #}
route-map RM_VMS_IN_V6 deny 4
 match ipv6 address prefix-list PL_K8S_SERVICES_V6
exit
!
route-map RM_VMS_IN_V6 permit 10
 match ipv6 address prefix-list PL_TENANT_V6
exit
!
route-map RM_VMS_IN_V6 permit 5
 match ipv6 address prefix-list PL_K8S_PODS_V6
 match large-community CL_K8S_INTERNAL
exit
!
route-map RM_VMS_IN_V6 deny 6
 match ipv6 address prefix-list PL_K8S_PODS_V6
exit
!
{# The LB pool is outside fd00:<cluster>::/48, so it must be admitted by its
   dedicated prefix list before the final deny. #}
route-map RM_VMS_IN_V6 permit 7
 match ipv6 address prefix-list PL_K8S_VIPS_V6
exit
!
{% if VMS_LOCAL_PREF_ANYCAST_V6 | length > 0 and VMS_ANYCAST_NS.local_next_hops | length > 0 %}
route-map RM_VMS_IN_V6 permit 8
 match ipv6 address prefix-list PL_VMS_LOCALPREF_ANYCAST_V6
 match ipv6 next-hop prefix-list PL_VMS_LOCALPREF_NH_V6
 set local-preference {{ vms_local_pref_anycast_v6_local_preference | default(500) }}
exit
!
{% endif %}
route-map RM_VMS_IN_V6 permit 15
 match ipv6 address prefix-list PL_TENANT_GUA_V6
exit
!
route-map RM_VMS_IN_V6 permit 20
 match ipv6 address prefix-list PL_K8S_LOOPBACKS_V6
exit
!
route-map RM_VMS_IN_V6 deny 999
exit
!

{# --- VMS inbound policy (IPv4) --- #}
route-map RM_VMS_IN_V4 deny 5
 match ip address prefix-list PL_K8S_SERVICES_V4
exit
!
route-map RM_VMS_IN_V4 permit 10
 match ip address prefix-list PL_TENANT_V4
exit
!
route-map RM_VMS_IN_V4 deny 999
exit
!

{# --- VMS outbound policy (what we ADVERTISE to K8s VMs from VRF) --- #}
route-map RM_VMS_OUT_V4 deny 5
 match ip address prefix-list PL_K8S_SERVICES_V4
exit
!
route-map RM_VMS_OUT_V4 permit 10
 match ip address prefix-list PL_DEFAULT_V4
exit
!
route-map RM_VMS_OUT_V4 deny 999
exit
!

route-map RM_VMS_OUT_V6 deny 5
 match ipv6 address prefix-list PL_K8S_SERVICES_V6
exit
!
route-map RM_VMS_OUT_V6 permit 10
 match ipv6 address prefix-list PL_DEFAULT_V6
exit
!
route-map RM_VMS_OUT_V6 permit 20
 match ipv6 address prefix-list PL_SVCS_V6
exit
!
{# ENG-284: CP-only BGP session (kube_vip protocol) gets the apiserver VIP
   directly, but workers rely solely on this VMS export policy and had no
   matching clause - the VIP was Installed in every PVE host's VRF table
   but never advertised to worker VMs, which fell back to unreliable
   on-link ND resolution for an address inside their connected /64.
   Mirrors RM_GLOBAL_TO_VRF_V6 permit 35, which already leaks the same
   CL_K8S_PUBLIC-tagged tenant host routes (VIP, node /128s) into the VRF. #}
route-map RM_VMS_OUT_V6 permit 25
 match ipv6 address prefix-list PL_TENANT_V6
 match large-community CL_K8S_PUBLIC
exit
!
route-map RM_VMS_OUT_V6 permit 30
 match ipv6 address prefix-list PL_K8S_PODS_V6
 match large-community CL_K8S_INTERNAL
exit
!
route-map RM_VMS_OUT_V6 deny 999
exit
!

{# --- Controlled redistribution of Ceph service routes into GLOBAL BGP IPv6 --- #}
route-map RM_CONNECTED_TO_BGP_V6 permit 10
 match ipv6 address prefix-list PL_SVCS_V6
exit
!
route-map RM_CONNECTED_TO_BGP_V6 deny 999
exit
!
route-map RM_OSPF6_TO_BGP_V6 permit 10
 match ipv6 address prefix-list PL_SVCS_V6
exit
!
route-map RM_OSPF6_TO_BGP_V6 deny 999
exit
!

{# =====================================================================
   OSPF - Underlay (Ring + Shared L2)
   Global interface blocks with both IPv4 and IPv6 OSPF settings

   enp1s0f0np0/enp1s0f1np1 (the mesh links) have their area/network-type
   owned by PVE SDN Fabrics (see terraform/infra/modules/proxmox_sdn's
   fabric_ospf/fabric_node_ospf resources), which generates those stanzas
   into /etc/frr/frr.conf - do not duplicate that here.

   Fabric's generated stanzas don't set "no ip ospf passive", so they're
   silently passive under this file's "passive-interface default" below.
   FRR merges repeated "interface X" blocks additively, so this narrow
   override (just the passive flag) is enough without redeclaring area/
   network-type.
===================================================================== #}
interface enp1s0f0np0
 no ip ospf passive
exit
!
interface enp1s0f1np1
 no ip ospf passive
exit
!
interface vmbr0.10
 ip ospf area 0.0.0.0
 ip ospf network broadcast
 ip ospf cost 1000
 no ip ospf passive
 ipv6 ospf6 area 0.0.0.0
 ipv6 ospf6 network broadcast
 ipv6 ospf6 cost 1000
exit
!
interface lo
 ip ospf area 0.0.0.0
 ipv6 ospf6 area 0.0.0.0
exit
!
interface lo-infra
 ip ospf area 0.0.0.0
 ipv6 ospf6 area 0.0.0.0
exit
!
interface lo-svcs
 ip ospf area 0.0.0.0
 ipv6 ospf6 area 0.0.0.0
exit
!
router ospf
 ospf router-id {{ infra_ip4 }}
 passive-interface default
exit
!
router ospf6
 ospf6 router-id {{ infra_ip4 }}
exit
!

{# =====================================================================
   BGP - GLOBAL (edge-facing)
===================================================================== #}
router bgp {{ LOCAL_AS }}
 bgp router-id {{ infra_ip4 }}
 no bgp default ipv4-unicast
 bgp bestpath as-path multipath-relax
 bgp graceful-restart
 !
 neighbor IBGP peer-group
 neighbor IBGP remote-as {{ LOCAL_AS }}
 neighbor IBGP update-source {{ infra_ip6 }}
 neighbor IBGP bfd
 neighbor IBGP route-map RM_IBGP_IN in
 !
 neighbor EDGE peer-group
 neighbor EDGE remote-as {{ EDGE_AS }}
 neighbor EDGE description EDGE_RouterOS_MP-BGP
 neighbor EDGE update-source {{ infra_ip6 }}
 neighbor EDGE ebgp-multihop 5
 neighbor EDGE timers 10 30
 neighbor EDGE bfd profile EDGE_BFD
 neighbor EDGE capability extended-nexthop
 neighbor EDGE soft-reconfiguration inbound
 !
 neighbor {{ EDGE_V6 }} peer-group EDGE
{% for i in range(1, 4) %}
{% if i != node_id %}
 neighbor fd00:0:0:ffff::{{ i }} peer-group IBGP
{% endif %}
{% endfor %}
 !
 address-family ipv4 unicast
  neighbor {{ EDGE_V6 }} activate
  neighbor IBGP activate
  neighbor EDGE route-map RM_EDGE_IN_V4 in
{# ENG-328: decouple "who does SNAT exit-node duty" (stays all 3, via
   zones.cfg exitnodes - unrelated to this) from "who tells RouterOS
   about VM ownership" (now pve01/primary only). All 3 hosts still
   independently advertising identical VM host routes to RouterOS gave
   it no way to know which was authoritative - it picked arbitrarily,
   and for solwk01 tonight it picked wrong, silently breaking DNS/NTP.
   Non-primary nodes keep the EDGE session up (still need to learn the
   default route from RouterOS for their own use) but export nothing -
   only pve01 tells RouterOS about VM/tenant routes now, so there's
   nothing left to be ambiguous about. See
   docs/tickets/eng-322-vrf-evpnz1-ipv4-snat.md. #}
  neighbor EDGE route-map {{ 'RM_EDGE_EXPORT_V4' if node_id == 1 else 'RM_EDGE_EXPORT_NONE' }} out
  import vrf {{ VRF_NAME }}
  import vrf route-map RM_VRF_TO_GLOBAL_V4
 exit-address-family
 !
 address-family ipv6 unicast
  neighbor {{ EDGE_V6 }} activate
  neighbor IBGP activate
  neighbor IBGP route-map RM_IBGP_IN in
  neighbor EDGE route-map RM_EDGE_IN_V6 in
  neighbor EDGE route-map {{ 'RM_EDGE_EXPORT_V6' if node_id == 1 else 'RM_EDGE_EXPORT_NONE' }} out
  redistribute connected route-map RM_CONNECTED_TO_BGP_V6
  redistribute ospf6 route-map RM_OSPF6_TO_BGP_V6
  import vrf {{ VRF_NAME }}
  import vrf route-map RM_VRF_TO_GLOBAL_V6
 exit-address-family
 !
 address-family l2vpn evpn
{# ENG-322 / ENG-324: neighbor IBGP carries the same L2VPN EVPN NLRIs as
   VTEP but had no inbound policy at all, bypassing MAP_VTEP_IN's
   default-route local-preference downgrade entirely. See the
   MAP_VTEP_IN block above for the full explanation, and ENG-324 for
   why this is tracked as its own tech-debt item (no upstream Proxmox/
   FRR bug covers this gap). #}
  neighbor IBGP activate
  neighbor IBGP route-map MAP_VTEP_IN in
  advertise-all-vni
  advertise-svi-ip
 exit-address-family
exit
!

{# =====================================================================
   BGP - VRF (VM-facing)
===================================================================== #}
router bgp {{ LOCAL_AS }} vrf {{ VRF_NAME }}
 bgp router-id {{ vrf_router_id }}
 no bgp default ipv4-unicast
 bgp graceful-restart
 !
 neighbor VMS peer-group
 neighbor VMS remote-as external
 neighbor VMS timers 20 60
 neighbor VMS capability extended-nexthop
 neighbor VMS bfd
 !
{% for p in VMS_LISTEN_V4_LIST %}
 bgp listen range {{ p }} peer-group VMS
{% endfor %}
{% for p in VMS_LISTEN_V6_LIST %}
 bgp listen range {{ p }} peer-group VMS
{% endfor %}
 !
 address-family ipv4 unicast
  neighbor VMS activate
  import vrf default
  import vrf route-map RM_GLOBAL_TO_VRF_V4
  neighbor VMS route-map RM_VMS_IN_V4 in
  neighbor VMS route-map RM_VMS_OUT_V4 out
  redistribute connected
 exit-address-family
 !
 address-family ipv6 unicast
  neighbor VMS activate
  import vrf default
  import vrf route-map RM_GLOBAL_TO_VRF_V6
  neighbor VMS route-map RM_VMS_IN_V6 in
  neighbor VMS route-map RM_VMS_OUT_V6 out
  redistribute connected
 exit-address-family
 !
 address-family l2vpn evpn
  vni {{ VRF_VXLAN_ID }}
  advertise ipv4 unicast
  advertise ipv6 unicast
 exit-address-family
exit
!
line vty
!
