#!/usr/sbin/nft -f

flush ruleset

table inet filter {
	chain input {
		type filter hook input priority filter;
	}
	chain forward {
		type filter hook forward priority filter;

		# Clamp TCP MSS on traffic egressing via vmbr0 (the EVPN exit-node
		# path to RouterOS, fixed at MTU 1500 on all nodes). This lets vnet
		# MTU exceed 1500 for internal east-west fabric traffic without
		# breaking north-south TCP flows, and stays correct regardless of
		# which node currently holds the exit-node role since the rule is
		# identical on all three. See
		# docs/tickets/pve-frr-power-event-20260712.md
		oifname "vmbr0" tcp flags syn tcp option maxseg size set rt mtu

		# ENG-322: same clamp, but for vmbr0.10 - the actual interface
		# vrf_evpnz1 tenant traffic egresses through for real internet
		# destinations (see docs/tickets/eng-322-vrf-evpnz1-ipv4-snat.md).
		# Needed regardless of which NAT mechanism owns that path (large
		# TLS handshake packets should be clamped like everything else).
		oifname "vmbr0.10" tcp flags syn tcp option maxseg size set rt mtu
	}
	chain output {
		type filter hook output priority filter;
	}
}

# ENG-322: vrf_evpnz1 IPv4 exit-node SNAT is now handled by Proxmox's own
# native mechanism (per-subnet `snat: 1` in /etc/pve/sdn/subnets.cfg, on
# each of the 4 tenant IPv4 subnets), NOT by a hand-rolled nftables table
# here. The native path is standard/supported (per-vnet `post-up iptables
# ... -j SNAT` generated by PVE SDN's EvpnPlugin.pm, applied identically on
# every node so it stays correct through VM migration) and additionally
# adds an explicit conntrack zone for the tenant bridges (`iptables -t raw
# ... -j CT --zone 1`) that this hand-rolled table never had. A prior
# version of this file added a `table ip nat` here directly - removed,
# since running both simultaneously double-NATs. See
# docs/tickets/eng-322-vrf-evpnz1-ipv4-snat.md for the full history,
# including a still-open TLS-handshake-to-real-external-hosts gap that
# persists even with the native mechanism (root cause not yet found -
# ruled out: hand-rolled vs native NAT, multi- vs single-exit-node,
# Cilium's eBPF datapath, tcp_early_demux on the Talos VMs).
