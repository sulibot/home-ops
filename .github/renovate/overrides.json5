{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Keep ImmichFrame compatible with Immich 3.1 until the server is upgraded to 3.2 or newer",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/immichframe/immichframe"],
      allowedVersions: "/^v?1\\.0\\.38\\.0$/",
    },
    {
      description: "Upgrade generated Flux controllers with matching CRDs through the Flux distribution",
      matchManagers: ["kubernetes"],
      matchFileNames: ["kubernetes/clusters/**/flux-system/gotk-components.yaml"],
      enabled: false,
    },
    {
      description: "Override Helmfile Dependency Name",
      matchDatasources: ["docker"],
      matchManagers: ["helmfile"],
      overrideDepName: "{{packageName}}",
    },
    {
      description: "Override Talos Installer Package Name",
      matchDatasources: ["docker"],
      matchPackageNames: ["/factory\\.talos\\.dev/"],
      overridePackageName: "ghcr.io/siderolabs/installer",
    },
    {
      description: "Disable Kubernetes version updates (managed manually with coordinated Talos upgrades)",
      matchPackageNames: [
        "kubernetes/kubernetes",
        "ghcr.io/siderolabs/kubelet",
      ],
      enabled: false,
    },
    {
      description: "Allow Talos installer updates",
      matchPackageNames: ["ghcr.io/siderolabs/installer"],
      enabled: true,
    },
  ],
}
